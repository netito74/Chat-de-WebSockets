# Copiar a .env y ajustar segun el entorno.

NODE_ENV=development
PORT=3000
INSTANCE_ID=node-1

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=12h

DB_FILE=./data/agora.sqlite

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379

UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5

CORS_ORIGIN=*

# mock | google | deepl
TRANSLATION_PROVIDER=mock
TRANSLATION_CACHE_TTL_MS=3600000
TRANSLATION_CACHE_MAX=5000
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
